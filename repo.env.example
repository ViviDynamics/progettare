# Copy to repo.env (gitignored). Read by the scripts in .agents/skills/*/scripts.
VIVI_REPO=ViviDynamics/progettare
VIVI_DEFAULT_BRANCH=main
VIVI_MERGE_FLAGS="--squash --admin --delete-branch"
VIVI_TEST_COMMANDS_FILE=.agents/test-commands.md
VIVI_HOUSE_RULES_FILE=AGENTS.md

# A file holding a GitHub token with access to this repo. When unset, the scripts
# use GH_TOKEN or GITHUB_TOKEN from the environment instead.
# VIVI_GH_TOKEN_FILE=$HOME/Workspaces/.gh_token

# Optional. Project board: ViviDynamics project 18.
VIVI_PROJECT_OWNER=ViviDynamics
VIVI_PROJECT_NUMBER=18
VIVI_BRANCH_PATTERN=feat/tkt-{issue}-{slug}
VIVI_CI_WORKFLOW=
VIVI_FLAKE_SIGNATURES_FILE=.agents/flake-signatures.txt
VIVI_REVIEW_TOOL=self
# Per person: your GitHub login, set in your own repo.env. Leave it empty here.
VIVI_ASSIGNEE=
